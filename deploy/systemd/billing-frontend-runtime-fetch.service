[Unit]
Description=Foxugly Billing console — fetch runtime config from AWS SSM into an nginx snippet
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Force le rôle d'instance EC2 via IMDS en neutralisant les clés statiques
# certbot-route53 de /root/.aws, qui sinon le masquent (§3.5).
Environment=AWS_SHARED_CREDENTIALS_FILE=/dev/null
Environment=AWS_CONFIG_FILE=/dev/null
Environment=AWS_REGION=eu-west-1
# §3.10 : exécuté en root, donc HORS de l'arbre django.
ExecStart=/usr/local/sbin/billing-frontend-runtime-fetch.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
